# Copy to `.env` for local development (`cp .env.example .env`).
# Existing shell/process env vars always win over values here.
# Docker Compose also reads this file for ${VAR} substitution.

# Recommended for Option A (Vite UI proxies API to 8081)
PORT=8081
DATA_DIR=./data

# API_TOKEN=localagent-box
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=
# OLLAMA_BASE_URL=http://localhost:11434
# AGENT_WORKSPACE=
# MAX_CONCURRENT_AGENTS=3
# AGENT_TIMEOUT=3600
# OCR per-file review deadline in minutes (0 disables). OCR's own default is 10.
# OCR_REVIEW_TIMEOUT=30
# OCR per-request LLM HTTP timeout in seconds. OCR's own default is 300.
# OCR_LLM_TIMEOUT=600
# OPENCODE_BIN=opencode
# OPENCODE_MODEL=
# OPENCODE_PROVIDER=
# OPENCODE_PORT_BASE=4100
# OPENCODE_STARTUP_TIMEOUT_MS=900000
# Expose codegraph MCP to agents (requires @colbymchenry/codegraph in the image)
# ENABLE_CODEGRAPH=true
# Workspace bootstrap (P2-T4): auto-detect lockfiles without .localagent-box/environment.json
# BOOTSTRAP_AUTO_DETECT=true
# Global override for the setup timeout in ms
# BOOTSTRAP_SETUP_TIMEOUT_MS=600000
# LOG_LEVEL=debug
